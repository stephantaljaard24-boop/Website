{
  "name": "website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    // Static site is served directly; only /api/* runs the Worker code.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep any variables you set in the Cloudflare dashboard when deploying.
  "keep_vars": true
  // TODO: add the KV binding once we have the namespace ID:
  // "kv_namespaces": [{ "binding": "CHAT_KV", "id": "<namespace id>" }]
}
