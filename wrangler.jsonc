{
  "name": "website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    // Static site is served directly; only /api/* runs the Worker code.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep any variables you set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  // Chat history, webhook de-duplication, rate limits and bot pause flags.
  "kv_namespaces": [{ "binding": "CHAT_KV", "id": "7d89282718f84ae09aa783edb9f3fadd" }]
}
